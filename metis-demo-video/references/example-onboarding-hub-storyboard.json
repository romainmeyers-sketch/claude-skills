  "lines": {
   "hook": {
    "text": "Your first day at Metis started with a PDF.",
    "seed": 101
   },
   "pages": "Onboarding lived in PDF files. There was nothing to click. No way to track what you had done. And separate guides for new hires and coaches.",
   "beats1": "Read the guide.",
   "beats2": "Try to remember it.",
   "beats3": "Hope it sticks.",
   "reveal": {
    "text": "Meet the Metis Onboarding Hub. From PDF files to a living website.",
    "seed": 101
   },
   "cards": "Track every step. Click through guided help. And know the firm, all in one place.",
   "setup": "It starts with a quick setup. Pick your role and your office, and the hub adapts to you.",
   "six": "Your first day becomes six guided steps.",
   "day1": "Check items off as you go. Finish the last one, and the next step opens on its own.",
   "progress": "Your progress saves automatically, so there is nothing to track by hand.",
   "home": "Home shows where you are, and what comes next.",
   "roadmap": "The full roadmap runs from day one through week two.",
   "how": "Stuck on a task? Every one has step-by-step help.",
   "meet": "Then meet the firm. Your intro-call list starts with your own office's leadership.",
   "free": "Pick someone, and see when they are free, in your timezone.",
   "invite": "One click opens a pre-filled calendar invite.",
   "booked": "Mark it booked, and your tracker updates.",
   "culture": "Learn what the firm stands for.",
   "tools": "See every platform you will use, and who to ask.",
   "faq": "Get quick answers to the questions everyone asks.",
   "dict": {
    "text": "And pick up the language of the firm in the Metis dictionary.",
    "seed": 101
   },
   "close": "Your first day, handled."
  }
 },
